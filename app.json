{
  "android": {
    "adaptiveIcon": {
      "backgroundColor": "#7c3aed",
      "foregroundImage": "./assets/icon.png"
    },
    "package": "com.mlive.app",
    "permissions": [
      "CAMERA",
      "RECORD_AUDIO",
      "INTERNET"
    ],
    "versionCode": 1
  },
  "assetBundlePatterns": [
    "**/*"
  ],
  "displayName": "M Live",
  "extra": {
    "AGORA_APP_ID": "ac11cdc3f22b4f86bb2fceab3820b8d7",
    "eas": {
      "projectId": "fa0f08a5-0dde-430e-a549-2ae066d67337"
    }
  },
  "icon": "./assets/icon.png",
  "ios": {
    "bundleIdentifier": "com.mlive.app",
    "infoPlist": {
      "NSCameraUsageDescription": "M Live needs camera access so approved hosts can go live.",
      "NSMicrophoneUsageDescription": "M Live needs microphone access so approved hosts can go live."
    },
    "supportsTablet": true
  },
  "name": "m-live",
  "owner": "jack8435s-team",
  "orientation": "portrait",
  "plugins": [
    "expo-av"
  ],
  "scheme": "mlive",
  "slug": "m-live",
  "splash": {
    "backgroundColor": "#7c3aed",
    "image": "./assets/splash.png",
    "resizeMode": "contain"
  },
  "userInterfaceStyle": "light",
  "version": "1.0.0",
  "web": {
    "favicon": "./assets/icon.png"
  }
}
